{
    "name": "jwhulette/simplepointer",
    "type": "project",
    "description": "A simple pointing poker application.",
    "keywords": [
        "Pointing Poker",
        "Scrum",
        "Agile"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "guzzlehttp/guzzle": "^7.10.0",
        "laravel/framework": "^12.44.0",
        "laravel/reverb": "^1.6.3",
        "spatie/db-dumper": "^3.8.2"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.1.9",
        "barryvdh/laravel-debugbar": "^3.16.3",
        "barryvdh/laravel-ide-helper": "^3.6.1",
        "deployer/deployer": "^7.5.12",
        "fakerphp/faker": "^1.24.1",
        "friendsofphp/php-cs-fixer": "^3.92.3",
        "larastan/larastan": "^3.8.1",
        "laravel/boost": "^1.8.7",
        "laravel/dusk": "^8.3.4",
        "mockery/mockery": "^1.6.12",
        "nunomaduro/collision": "^8.8.3",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan-deprecation-rules": "^2.0.3",
        "phpstan/phpstan-mockery": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0.11",
        "phpunit/phpunit": "^12.5.4",
        "rector/rector": "^2.3.0",
        "spatie/laravel-ignition": "^2.9.1"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "ide": [
            "@php artisan ide-helper:generate",
            "@php artisan ide-helper:meta",
            "@php artisan ide-helper:model -W"
        ],
        "build": [
            "cd .docker/local; docker-compose up --build --force-recreate -d"
        ],
        "phpunit": [
            "./vendor/bin/phpunit --color=always"
        ],
        "phpstan": [
            "./vendor/bin/phpstan analyse --memory-limit=2G"
        ],
        "rector": [
            "./vendor/bin/rector"
        ],
        "cs-fix": [
            "./vendor/bin/php-cs-fixer fix"
        ],
        "dusk": [
            "@php artisan reverb:start > /dev/null 2>&1 &",
            "@php artisan dusk"
        ],
        "test": [
            "@php artisan test --compact --coverage"
        ],
        "ts": [
            "@phpstan",
            "@rector",
            "@cs-fix",
            "@phpunit",
            "@test",
            "@dusk"
        ]
    }
}
